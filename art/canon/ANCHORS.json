        "blue-hard-hat": [
          [
            47,
            64,
            0,
            128
          ],
          [
            39,
            60,
            8,
            17
          ],
          [
            46,
            64,
            18,
            62
          ]
        ]
      },
      "region": {
        "y0": 0,
        "y1": 120,
        "x0": 0,
        "x1": 128
      },
      "mask": "art/canon/masks/headwear.png",
      "source_dir": "art/ai/out/head_final/headwear"
    },
    "tool": {
      "kind": "sprite",
      "zone": {
        "x0": 80,
        "y0": 74,
        "x1": 126,
        "y1": 127
      },
      "anchor": "bottom-right",
      "div": 3
    },
    "companion": {
      "kind": "sprite",
      "zone": {
        "x0": 2,
        "y0": 72,
        "x1": 48,
        "y1": 127
      },
      "anchor": "bottom-left",
      "div": 3
    },
    "bug": {
      "kind": "sprite",
      "zone": {
        "x0": 2,
        "y0": 2,
        "x1": 46,
        "y1": 46
      },
      "anchor": "top-left",
      "div": 3
    },
    "legendary": {
      "kind": "chip",
      "mode": "emblem_chip",
      "zone": {
        "x0": 44,
        "y0": 2,
        "x1": 124,
        "y1": 66
      },
      "zone_status": "provisional v3 (session 30) — поле чипа 80×64; факт: max 79×36, 53×56, 40×58, 28×64",
      "place": {
        "anchor": "top-right",
        "x": 124,
        "y": 2
      },
      "source": "art/canon/legendary_chips/<trait-id>.png"
    },
    "golden": {
      "kind": "full",
      "note": "override-слой (render_override: bat-hat→headwear, house-cat→companion, fat-rat→bug); в микс НЕ входит"
    }
  },
  "golden": {
    "enabled_when": {
      "legendary": "none"
    },
    "chance": 0.03,
    "threshold": 1966,
    "order": [
      "house-cat",
      "fat-rat"
    ],
    "render_override": {
      "house-cat": "companion",
      "fat-rat": "bug"
    },
    "status": "rules only (session 30: bat-hat event removed — order/override почищены); override-слои в traits/Golden; демо-карты в art/ai/out/golden_demo"
  }
}