  "golden": {
    "kind": "conditional_override",
    "only_when": {
      "slot": "legendary",
      "value": "None"
    },
    "chance_percent": 3,
    "threshold": 1966,
    "threshold_note": "3% of the 16-bit space: floor(0.03 * 65536) = 1966. Success when a raw uint16 word < 1966.",
    "order": "first_success_wins",
    "checks": [
      {
        "event": "House Cat",
        "requires_slot": "companion",
        "requires_value": "House Cat"
      },
      {
        "event": "Fat Rat",
        "requires_slot": "companion",
        "requires_value": "Fat Rat"
      }
    ],
    "_note": "Single first-success order (the v1 mechanics doc.md section 3 pseudocode): a check runs (and consumes one word) only when its prerequisite is met; the first success wins. Bat Hat was removed from the collection (session 27: hats cut, owner-approved), so its golden event is gone; both remaining events gate on the companion slot, hence at most one check can be eligible per token. Golden rendering mechanics remain a separate open item."
  },
  "bug": {
    "kind": "conditional_weighted",
    "only_when_legendary": "None",
    "only_when_golden": false,
    "_note": "Bug is only rolled when legendary == None AND golden == false. Otherwise bug is forced to 'None'."
  },
