{
  "theme": "house card",
  "version": "house-card/1",
  "_note": "CANONICAL ART + METADATA SPEC for the House Card collection. Slot order, values, weights and the conditional golden/bug rules follow the v1 mechanics doc.md exactly. Weights are stored twice: 'weight' is the integer weight used by the PRNG (doc percent x10, units of 0.1%); 'percent' is the human/doc percentage. Each weighted slot's integer weights sum to 1000 (= 100%). Changing any slot, value, weight or their order changes traits for ALL tokens.",
  "prng": {
    "hash": "keccak256 (Ethereum keccak, NOT NIST SHA3)",
    "payload": "seed_bytes32 || uint8(slotIndex) || uint16(repeatCounter)",
    "words_per_digest": 16,
    "word_encoding": "big-endian uint16",
    "rejection": "acceptedRange = floor(65536 / totalWeight) * totalWeight; candidates >= acceptedRange are skipped",
    "counter_reset": "repeatCounter resets to 0 for every slot (a rejection in one slot never affects another)"
  },
  "weight_units": "0.1% (doc percent x10); each weighted slot sums to 1000 = 100%",
  "note_weight_scale": "the v1 mechanics doc.md gives percentages; several slots contain fractional values (2.5, 1.5, 0.5, 0.1, ...). The PRNG (web/lib/prng.ts) requires integer weights, so weights are scaled x10 (units of 0.1%). x10 is the smallest factor that makes every doc value an integer.",
